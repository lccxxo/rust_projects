# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# 监听地址与端口
APP_HOST=127.0.0.1
APP_PORT=3000

# 日志等级：trace / debug / info / warn / error
# 也可用 RUST_LOG 做更细粒度控制，如 RUST_LOG=web_skeleton=debug,tower_http=debug
APP_LOG_LEVEL=info

# 请求超时（秒）
APP_REQUEST_TIMEOUT_SECS=30

# 请求体大小上限（字节），默认 2MB
APP_BODY_LIMIT_BYTES=2097152
